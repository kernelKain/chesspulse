# Copy this file to .env and put real values only in .env.
# This file stays empty and is safe to commit.
# ChessPulse reads .env once at startup. Restart the app after changing it.

# SmartSpectra SDK key. Read by the main process only.
SMARTSPECTRA_API_KEY=

# Optional AI explanations. The app chooses the provider from this file only.
# One of: openai, anthropic, google, opencode, custom
CP_AI_PROVIDER=

# Key for the AI provider named above.
CP_AI_KEY=

# Required when CP_AI_PROVIDER=custom; optional for opencode.
# OpenCode pay-as-you-go (default): https://opencode.ai/inference/openai/v1
# OpenCode Go subscription:         https://opencode.ai/inference/go/openai/v1
CP_AI_BASE_URL=

# Model id for the selected provider, for example deepseek-v4.1-flash on OpenCode Go.
CP_AI_MODEL=
