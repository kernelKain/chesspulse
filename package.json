{
  "name": "chesspulse",
  "version": "0.0.0",
  "private": true,
  "description": "Post-game chess review aligned with a local pulse trace.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer-test.json && node scripts/run-tests.mjs",
    "test:e2e": "npm run build && node --test scripts/e2e/electron.test.mjs",
    "test:bash": "npm run build && node --test scripts/e2e/bug-bash.mjs",
    "test:layout": "npm run build && node --test scripts/e2e/layout.test.mjs",
    "evidence:collect": "node scripts/evidence/collect.mjs",
    "evidence:limit-build": "node scripts/evidence/limit-build.mjs",
    "test:consent": "npm run build && electron scripts/consent-bridge.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build && vite build --config vite.preload.mts",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dev": "node scripts/dev.mjs",
    "report": "tsc -p tsconfig.node.json && node dist-electron/main/report.js",
    "doctor": "tsc -p tsconfig.node.json && node dist-electron/main/doctor-cli.js",
    "bench:depth": "tsc -p tsconfig.node.json && node scripts/engine-depth-bench.mjs",
    "start": "electron .",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:copy": "node scripts/copy-check.mjs"
  },
  "build": {
    "appId": "local.chesspulse.app",
    "productName": "ChessPulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/@smartspectra/node-sdk-*/**",
      "!node_modules/stockfish/bin/stockfish-19.js",
      "!node_modules/stockfish/bin/stockfish-19.wasm",
      "!node_modules/stockfish/bin/stockfish-19-single.js",
      "!node_modules/stockfish/bin/stockfish-19-single.wasm",
      "!node_modules/stockfish/bin/stockfish-19-lite.js",
      "!node_modules/stockfish/bin/stockfish-19-lite.wasm",
      "!node_modules/stockfish/bin/stockfish-19-asm.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/@smartspectra/node-sdk-linux-x64",
        "to": "smartspectra",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "artifactName": "ChessPulse-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "chess.js": "1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
