# ---------------------------------------------------------------------------
# ChessPulse .gitignore
#
# docs/ holds the published project documents. docs/drafts/ is private
# working material and stays out of git.
# ---------------------------------------------------------------------------
docs/drafts/
# Vendor proof sample used to test Electron before the product scaffold exists.
# It is not the app, and it must not be committed (native runtimes, possible local keys).
spikes/

# Secrets: never tracked. Only the empty template is committed.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Node / TypeScript build output
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-electron/
dist-renderer-test/
out/
build/
.vite/
coverage/
*.tsbuildinfo
*.local

# ---------------------------------------------------------------------------
# Packaging artefacts (Electron builds, engine binaries fetched at install)
# ---------------------------------------------------------------------------
release/
*.AppImage
*.deb
*.rpm
*.snap
*.exe
*.dmg

# ---------------------------------------------------------------------------
# Logs and local captures (a captured session must never land in git,
# except the two example sessions in demo/sessions/).
# PGN test fixtures under tests/fixtures/ are intentionally tracked so the
# public parse suite can run; real captured sessions are not.
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
sessions/
*.session.json
# The two shipped example sessions are public on purpose (see demo/README.md).
!demo/sessions/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
