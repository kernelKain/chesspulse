{
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/entire.sh before-submit-prompt"
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/entire.sh pre-compact"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/entire.sh session-end"
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/entire.sh session-start"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/entire.sh stop"
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/entire.sh subagent-start"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/entire.sh subagent-stop"
      }
    ]
  },
  "version": 1
}
